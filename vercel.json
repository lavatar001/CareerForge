{
  "version": 2,
  "framework": null,
  "buildCommand": "rm -rf dist && mkdir -p dist && cp -r index.html app.html public dist/",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}

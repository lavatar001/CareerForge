# CareerForge environment variables — set these in Vercel (Project → Settings → Environment Variables).
# Client JS may reference ONLY SUPABASE_URL and SUPABASE_ANON_KEY (via public/js/config.js).

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=            # safe client-side
SUPABASE_SERVICE_ROLE_KEY=    # SERVER ONLY — never ship to client

# AI
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Jobs (Phase 3)
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Payments (Phase 4)
STRIPE_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=

# Alerts (Phase 5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

APP_URL=https://careerforge.example.com
